# Twilio (Auth Token used for HMAC webhook signature verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telnyx (AU telephony — TeXML compatible, optional if only using Twilio)
# TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELNYX_PUBLIC_KEY=your-public-key-for-webhook-signature-verification

# Deepgram — free $200 credit at console.deepgram.com
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL (ngrok HTTPS URL or Fly.io URL, no trailing slash)
PUBLIC_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# Public URL of the Next.js app — used to build recording webhook URLs that
# Twilio/Telnyx will POST to. REQUIRED for call recording to work; if unset,
# recording is silently disabled.
APP_PUBLIC_URL=

# Server port
PORT=3001

# Supabase (service role for database access)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Internal API (Next.js app for post-call processing)
INTERNAL_API_URL=https://your-app.vercel.app
INTERNAL_API_SECRET=random-secret-here

# Test calls (browser WebSocket — shared secret with Next.js app)
TEST_CALL_SECRET=random-secret-shared-with-nextjs-app

# Sentry (error tracking — optional, disabled when not set)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# AI model overrides (SCRUM-588) — leave unset to use the default in code.
# They double as revert levers: set the previous model, restart, no code change.
# GEMINI_LIVE_MODEL=models/gemini-3.8-live  # production voice (Gemini Live); previous: models/gemini-3.1-flash-live-preview
# ANALYSIS_MODEL=gpt-6-luna                 # post-call analysis, transcript cleanup, re-transcription judge. Tested for analysis: gpt-6-luna (default) and gpt-4.1-mini (revert); other reasoning models are untested for analysis — their hidden reasoning shares the 600-token cap and can end finish_reason "length" with empty content
# VALIDATOR_MODEL=claude-haiku-5-5          # mid-call Tier-2 tool-result validator; previous: claude-haiku-4-5-20251001
# DEMO_MAX_CALL_MINUTES=3                     # public demo call limit (website demo + demo phone line), whole minutes 1-15
# LLM_PROVIDER=openai                       # classic (fallback) pipeline provider: openai | anthropic | gemini
# LLM_MODEL=                                # classic pipeline model; default per provider: gpt-4.1-mini | claude-haiku-5-5 | gemini-3.5-flash. supported: openai gpt-4.x or gpt-5.1+/gpt-6+ (gpt-5/o-series would run at default effort — too slow for voice), anthropic claude-haiku-5-5 or claude-haiku-4-5-20251001, gemini gemini-3.5-flash or gemini-3.8-flash
# CR_LLM_MODEL=claude-haiku-5-5             # ConversationRelay test pipeline (Claude)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1    # OpenAI Realtime test pipeline and the Gemini Live failover

# Inbound audio front-end (SCRUM-555) — DEFAULT ON when unset.
# RNNoise denoising + VAD-gated AGC on caller audio before Gemini. Set "off"
# to fall back to the legacy conversion path (instant kill switch, no deploy).
# AUDIO_FRONTEND=on

# Custom turn-taking (SCRUM-556) — DEFAULT OFF. EXPERIMENTAL: disables
# Gemini's automatic VAD and drives manual turn markers from the voice
# server's own noise-floor dominance gate (lib/turn-gate.js). Requires the
# audio front-end (falls back to automatic VAD when it's unavailable). Turn
# it on only for supervised test calls until tuned. Known trade-offs to
# verify on the first supervised call: ~120ms of speech onset falls outside
# the activity window (onset clipping vs latency knob = OPEN_BLOCKS), and
# realtimeInput.text injections (greeting trigger, mid-call correction
# nudges) may not register outside an activity window — check the greeting
# speaks within ~2s and corrections are spoken promptly.
# CUSTOM_VAD=off

# Greeting guard (SCRUM-576) — DEFAULT ON when unset.
# Room noise at pickup could make Gemini's VAD cancel its own greeting turn
# before it emitted any audio, leaving the caller and the AI both waiting in
# silence for the rest of the call (observed: a demo visitor sat through 17s of
# nothing). The guard holds inbound audio while the greeting is being delivered
# — noise Gemini never receives cannot trip its VAD — and re-sends the greeting
# trigger if a cancel still lands before the caller heard anything.
# TRADE-OFF: a caller who talks over the greeting is not heard until it ends
# (bounded: 6s per attempt, 9s absolute). This is deliberate — it also
# guarantees the recording disclosure is actually spoken.
# Set "off" to restore the pre-SCRUM-576 behaviour with no deploy.
# GREETING_GUARD=on

# Outbound smoke-test dialer (SCRUM-413) — DEFAULT OFF.
# The /outbound/* endpoints place REAL Twilio calls; they 404 unless ENABLED is
# "true". When enabled, OUTBOUND_ALLOWED_NUMBERS is FAIL-CLOSED: if it is unset,
# every call is rejected — list the exact E.164 test numbers to dial. Runs on a
# single Fly machine (the rate limit is per-process).
# OUTBOUND_SMOKE_TEST_ENABLED=false
# OUTBOUND_ALLOWED_NUMBERS=+61412345678,+14155550100
# OUTBOUND_RATE_MAX=30
# OUTBOUND_CALLER_NUMBER=+61...   # dedicated Twilio number the caller persona dials from

# SCRUM-587 — owner assistant (the tradie rings their own number + PIN).
# Voice-server flag; the Next.js Settings card/API use OWNER_ASSISTANT_UI_ENABLED.
# Needs migration 00171 (owner_access) applied first.
OWNER_ASSISTANT_ENABLED=false
# Pipeline for OWNER calls only: "gemini-live" | "classic". Unset = VOICE_PIPELINE.
# OWNER_PIPELINE=

# Fast classic pipeline (SCRUM-594) — DEFAULT OFF: unset = no change.
# Moves the published demo line (the numbers in DEMO_LINE_NUMBERS) from VOICE_PIPELINE
# to Deepgram Flux STT + Claude + streaming Aura TTS, so Deepgram hears and Claude thinks.
# English-only (Flux), customer calls only: owner calls and /ws/test never use it. Needs
# Claude's key for its gateway (ANTHROPIC_API_KEY, or OPENROUTER_API_KEY with
# ANTHROPIC_GATEWAY=openrouter) and DEEPGRAM_API_KEY; without them, with a FAST_LLM_MODEL the
# gateway won't take, or while Claude refuses requests, the call takes VOICE_PIPELINE and one
# warning is logged per process.
# Values: classic-fast (the fast variant) | classic | gemini-live (the last two pin the demo
# line to that pipeline). Blank = unset; an unrecognised value is ignored, with one warning.
# Kill switch: unset it (fly secrets unset DEMO_LINE_PIPELINE -a phondo-voice). Setting or
# unsetting a Fly secret restarts the machine, so do it when no call is live.
# DEMO_LINE_PIPELINE=classic-fast
# FAST_DEEPGRAM_HOST=api.au.deepgram.com    # Deepgram host for Flux, the Aura stream and the fast path's greeting/disclosure synthesis (same API key). Default: Deepgram's Australian endpoint
# FLUX_EOT_THRESHOLD=0.7                    # 0.5-1.0: how sure Flux must be that the caller has finished. Lower answers sooner but may cut in on a pause
# FLUX_EAGER_EOT_THRESHOLD=0.4              # 0.3-0.9 and not above FLUX_EOT_THRESHOLD, or "off": Flux's early end-of-turn guess, which starts a silent draft reply in Claude. "off" = no drafts (replies start later)
# FLUX_EOT_TIMEOUT_MS=5000                  # 500-60000: Flux ends a turn after this much silence even when unsure. An invalid FLUX_* value warns once and uses its default
# FAST_LLM_MODEL=claude-haiku-5-5           # the fast path's Claude model (always Claude, whatever LLM_PROVIDER says); revert lever: claude-haiku-4-5-20251001. Haiku models run with thinking off
# Anthropic gateway (SCRUM-594) — DEFAULT OFF: unset = api.anthropic.com with ANTHROPIC_API_KEY.
# "openrouter" sends the voice server's Claude requests (the fast path, ConversationRelay and the
# Tier-2 turn validator) to OpenRouter's Anthropic-compatible endpoint with OPENROUTER_API_KEY,
# pinned to Anthropic's own servers: a stopgap while the Anthropic balance is empty. Haiku 5.5
# only: a FAST_LLM_MODEL, VALIDATOR_MODEL or CR_LLM_MODEL it won't take is named in the boot log.
# The classic fallback's LLM_PROVIDER=anthropic still calls Anthropic directly. Either way, a
# refusal that repeats on every request (no credit, a spent limit, a bad key) raises one alert and
# keeps the demo line on VOICE_PIPELINE until the server restarts: a new key (fly secrets set)
# restarts it; after a top-up or a raised cap, run fly apps restart phondo-voice. A restart cuts
# live calls on every line, so do either when no call is live.
# Undo after the top-up: fly secrets unset ANTHROPIC_GATEWAY OPENROUTER_API_KEY -a phondo-voice
# ANTHROPIC_GATEWAY=openrouter
# OPENROUTER_API_KEY=
# NO_TURN_WATCHDOG=log                      # log (default) or act: when the caller's audio carries speech but Flux reports no turns (another language?), log it and capture at warning level, once a call; act also hands the call to Nova and asks the caller to repeat. Anything else warns once and logs

# Aura loudness (SCRUM-594, phone test F7) — DEFAULT ON (+6 dB) when unset.
# Every Aura (Deepgram TTS) frame, classic and fast path, greeting and disclosure included, gets this
# gain plus a soft limiter (lib/aura-gain.js): Aura voices reach the caller 4-8 dB under Gemini.
# Gemini and the hold audio are untouched. 0-12 dB; 0 or "off" (false/no/none/disabled) = off, the
# kill switch; above 12 is clamped to 12 and below 0 to 0 (= off), each with one warning; anything else
# that is not a number warns once and uses 6. The first Aura audio of each process logs the gain in use
# ("[AuraGain] Aura audio at +6 dB", or "[AuraGain] Aura boost is OFF").
# AURA_GAIN_DB=6
