# Twilio (Auth Token used for HMAC webhook signature verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telnyx (AU telephony — TeXML compatible, optional if only using Twilio)
# TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELNYX_PUBLIC_KEY=your-public-key-for-webhook-signature-verification

# Deepgram — free $200 credit at console.deepgram.com
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL (ngrok HTTPS URL or Fly.io URL, no trailing slash)
PUBLIC_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# Public URL of the Next.js app — used to build recording webhook URLs that
# Twilio/Telnyx will POST to. REQUIRED for call recording to work; if unset,
# recording is silently disabled.
APP_PUBLIC_URL=

# Server port
PORT=3001

# Supabase (service role for database access)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Internal API (Next.js app for post-call processing)
INTERNAL_API_URL=https://your-app.vercel.app
INTERNAL_API_SECRET=random-secret-here

# Test calls (browser WebSocket — shared secret with Next.js app)
TEST_CALL_SECRET=random-secret-shared-with-nextjs-app

# Sentry (error tracking — optional, disabled when not set)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# AI model overrides (SCRUM-588) — leave unset to use the default in code.
# They double as revert levers: set the previous model, restart, no code change.
# GEMINI_LIVE_MODEL=models/gemini-3.8-live  # production voice (Gemini Live); previous: models/gemini-3.1-flash-live-preview
# ANALYSIS_MODEL=gpt-6-luna                 # post-call analysis, transcript cleanup, re-transcription judge; previous: gpt-4.1-mini. Supported: gpt-4.x, gpt-5.1+/gpt-6+ (sent effort "none"), gpt-5/-mini/-nano and o-series (default effort)
# VALIDATOR_MODEL=claude-haiku-5-5          # mid-call Tier-2 tool-result validator; previous: claude-haiku-4-5-20251001
# LLM_PROVIDER=openai                       # classic (fallback) pipeline provider: openai | anthropic | gemini
# LLM_MODEL=                                # classic pipeline model; default per provider: gpt-4.1-mini | claude-haiku-5-5 | gemini-3.5-flash. supported: openai gpt-4.x or gpt-5.1+/gpt-6+ (gpt-5/o-series would run at default effort — too slow for voice), anthropic claude-haiku-5-5 or claude-haiku-4-5-20251001, gemini gemini-3.5-flash or gemini-3.8-flash
# CR_LLM_MODEL=claude-haiku-5-5             # ConversationRelay test pipeline (Claude)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1    # OpenAI Realtime test pipeline and the Gemini Live failover

# Inbound audio front-end (SCRUM-555) — DEFAULT ON when unset.
# RNNoise denoising + VAD-gated AGC on caller audio before Gemini. Set "off"
# to fall back to the legacy conversion path (instant kill switch, no deploy).
# AUDIO_FRONTEND=on

# Custom turn-taking (SCRUM-556) — DEFAULT OFF. EXPERIMENTAL: disables
# Gemini's automatic VAD and drives manual turn markers from the voice
# server's own noise-floor dominance gate (lib/turn-gate.js). Requires the
# audio front-end (falls back to automatic VAD when it's unavailable). Turn
# it on only for supervised test calls until tuned. Known trade-offs to
# verify on the first supervised call: ~120ms of speech onset falls outside
# the activity window (onset clipping vs latency knob = OPEN_BLOCKS), and
# realtimeInput.text injections (greeting trigger, mid-call correction
# nudges) may not register outside an activity window — check the greeting
# speaks within ~2s and corrections are spoken promptly.
# CUSTOM_VAD=off

# Greeting guard (SCRUM-576) — DEFAULT ON when unset.
# Room noise at pickup could make Gemini's VAD cancel its own greeting turn
# before it emitted any audio, leaving the caller and the AI both waiting in
# silence for the rest of the call (observed: a demo visitor sat through 17s of
# nothing). The guard holds inbound audio while the greeting is being delivered
# — noise Gemini never receives cannot trip its VAD — and re-sends the greeting
# trigger if a cancel still lands before the caller heard anything.
# TRADE-OFF: a caller who talks over the greeting is not heard until it ends
# (bounded: 6s per attempt, 9s absolute). This is deliberate — it also
# guarantees the recording disclosure is actually spoken.
# Set "off" to restore the pre-SCRUM-576 behaviour with no deploy.
# GREETING_GUARD=on

# Outbound smoke-test dialer (SCRUM-413) — DEFAULT OFF.
# The /outbound/* endpoints place REAL Twilio calls; they 404 unless ENABLED is
# "true". When enabled, OUTBOUND_ALLOWED_NUMBERS is FAIL-CLOSED: if it is unset,
# every call is rejected — list the exact E.164 test numbers to dial. Runs on a
# single Fly machine (the rate limit is per-process).
# OUTBOUND_SMOKE_TEST_ENABLED=false
# OUTBOUND_ALLOWED_NUMBERS=+61412345678,+14155550100
# OUTBOUND_RATE_MAX=30
# OUTBOUND_CALLER_NUMBER=+61...   # dedicated Twilio number the caller persona dials from
